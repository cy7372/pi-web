# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
# pi-auto-backup managed block
# Windows reserved device names — git cannot read these files
nul
con
aux
prn
com1
com2
com3
com4
lpt1
lpt2
lpt3

# Volatile runtime files
*.db-wal
*.db-shm
*.recovery-*

# pi-web 本地启动/停止脚本与运行时产物(非仓库内容)
/start-pi-web.ps1
/stop-pi-web.ps1
/pi-web.log
/pi-web.pid
/pi-web.server.pid

# build artifacts (USERPROFILE bypass dir + transient build log)
/.build-home/
/build-full.log

# runtime logs (Servy-managed)
/logs/
e2e_*.mjs

