{
  "name": "@agegr/pi-web",
  "version": "0.9.0",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "preinstall": "node -e \"const raw=process.env.npm_execpath; const base=raw?raw.toLowerCase().split(String.fromCharCode(92)).pop().split('/').pop():''; if(raw && base!=='bun' && base!=='bun.exe' && base!=='bunx') { console.error('[pi-web] wrong package manager: '+base+' ('+raw+') - this repo uses bun. Run: bun install'); process.exit(1) }\"",
    "postinstall": "node bin/prepare-terminal.js",
    "dev": "node deploy/dev.mjs -H 127.0.0.1 -p 30141",
    "dev:lan": "node deploy/dev.mjs -H 0.0.0.0 -p 30141",
    "build": "node deploy/build.mjs",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "5.4.1",
    "next": "16.3.4",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "^5.0.0",
    "semver": "7.8.0",
    "undici": "8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
