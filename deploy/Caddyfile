# pi-web 公网部署(Windows + Caddy + Servy,单实例多用户)
#
# 架构:
#   alice.<域> ┐
#   bob.<域>   ─┼─HTTPS─▶ Caddy basicauth ─▶ 127.0.0.1:30141 (Servy pi-web)
#   carol.<域> ┘                                  .pi = C:/pi-web-data/.pi (全员共享)
#
# 所有人共享同一个 ~/.pi:session 历史/LLM key/配置/文件白名单互通。
# 这是"几个信任的人"为省运维成本做的取舍。
# 改完: servy-cli restart --name=pi-caddy

# ── 多用户共享一个后端 ──
# 每个人一个 basicauth 用户名,反代到同一个 pi-web 实例
alice.pi.yourdomain.com {
	encode zstd gzip
	log {
		output file C:/pi-web-data/logs/caddy.log { roll_size 10mb; roll_keep 5 }
		format console
	}

	# basicauth 放所有用户名。浏览器会弹原生框,各自输各自的账号密码
	basicauth {
		alice $2a$14$REPLACE_WITH_BCRYPT_HASH_FOR_ALICE
		bob   $2a$14$REPLACE_WITH_BCRYPT_HASH_FOR_BOB
		carol $2a$14$REPLACE_WITH_BCRYPT_HASH_FOR_CAROL
	}

	reverse_proxy 127.0.0.1:30141 {
		flush_interval -1
		transport http { read_timeout 24h; write_timeout 24h }
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# 加 / 删用户:只在 basicauth 块里加/删一行
#   caddy hash-password  生成 hash → 加一行 → servy-cli restart --name=pi-caddy
